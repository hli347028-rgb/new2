# Reference https://github.com/github/gitignore/blob/master/Go.gitignore
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a
*.so

# OS General
Thumbs.db
.DS_Store

# project
*.cert
*.key
*.log
bin/
configs/config.yaml

# Develop tools
.vscode/
.idea/
*.swp

# Frontend deps / builds
web/node_modules/
web/dist/
admin/node_modules/
admin/dist/

# Local deploy artifacts
deploy/
deploy-build/
server-linux
taurus-deploy.tar.gz
taurus-deploy.zip
*.pem
backend.sql

# Local source snapshots and migration scratch files
_upstream_aix/
ken008009-aix-source/
web-before-ken008009/
_backendAdapter.integration.ts

# Nginx runtime state (keep nginx.conf and helper scripts)
nginx/logs/
*.pid
